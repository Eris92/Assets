<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="out/**;tests/**" />
    <Compile Remove="tests/**" />
    <Content Include="scripts/*.ps1" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="out/**;tests/**" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>
